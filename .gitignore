# ==============================================================================
#  .gitignore — 库表字段内容检索器（MssqlFieldFinder）
#
#  本文件是按本项目的实际目录结构编写的，不是通用模板。
#  规则分成 7 组，每组上方有一行分组说明，具体条目上方注明了「为什么忽略」。
#  标 ★ 的是本项目特有、且与其它项目容易混淆的条目，改动前请先看说明。
#
#  一句话原则：源码、脚本、文档、测试、截图提交；
#              构建产物、运行期配置、编辑器/系统垃圾不提交。
#
#  注意：git 的 .gitignore **不支持行尾注释**——`*.tmp  # 说明` 会被整体当成模式，
#        从而匹配不到任何文件。说明一律单独占一行（本文件已遵循此写法）。
# ==============================================================================


# ------------------------------------------------------------------------------
#  1. 打包产物与构建中间文件（由 bat\build.bat 生成，可随时重建，且体积大）
# ------------------------------------------------------------------------------

# PyInstaller 的中间目录（TOC/PYZ/PKG 等），约 14 MB，每次打包自动重建
/build/

# PyInstaller 默认产物目录。本项目已改用「程序名」作为产物目录（见下条），
# 这条留着是为了兜底：手工执行 PyInstaller 而不传 --distpath 时会落到这里
/dist/

# 本项目的产物目录 = 程序名（取自 src/__init__.py 的 __app_name__）。
# 里面是自包含的 exe（约 10 MB），并且运行后还会生成 config.json / connections.json。
# ★ 若将来改了 __app_name__，记得同步修改本行的目录名。
/MssqlFieldFinder/

# 各类打包/编译的通用中间产物
# （下面 *.spec.bak 是手改 MssqlFieldFinder.spec 前的备份；
#   注意 *.spec 本身不在忽略范围内，见文末说明）
*.spec.bak
*.pkg
*.toc
*.manifest


# ------------------------------------------------------------------------------
#  2. 运行期配置文件与日志（★ 最重要的一组：可能含数据库凭据）
# ------------------------------------------------------------------------------

# 主窗口设置。只记录与默认值不同的项，但**可能包含密码**（「记住密码」默认开启）
config.json

# 连接方案集合。含服务器地址、实例名、账号，以及明文密码（当方案勾了「记住密码」）。
# 属于个人/环境相关数据，绝不能进仓库
connections.json

# 部署自检输出（`<exe> --check` 的落盘结果），含本机路径、账号身份与驱动清单
selfcheck.log

# 其他日志与崩溃痕迹
*.log
*.dmp


# ------------------------------------------------------------------------------
#  3. WorkBuddy 工作区数据（会话记忆等，属于本地工作状态，不随代码走）
# ------------------------------------------------------------------------------
.workbuddy/


# ------------------------------------------------------------------------------
#  4. Python 运行时缓存与虚拟环境
# ------------------------------------------------------------------------------

# 字节码缓存：每次运行自动重建
__pycache__/
*.py[cod]
*$py.class

# 本地虚拟环境。本项目开发时用的是外部隔离环境，
# 但协作者可能自建，统一忽略以免误提交上千个文件
.venv/
venv/
env/
ENV/
.conda/

# 打包/安装产生的元数据
*.egg-info/
.eggs/

# 测试与静态检查缓存（本项目只用标准库 unittest，这类目录一般不会出现，兜底忽略）
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/


# ------------------------------------------------------------------------------
#  5. 编辑器与 IDE 的个人配置（各人偏好不同，不应强加给协作者）
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
*.bak
*.orig
*.rej


# ------------------------------------------------------------------------------
#  6. Windows / macOS 系统垃圾文件
# ------------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
._*


# ------------------------------------------------------------------------------
#  7. 本地临时文件（调试脚本、导出物等；留个兜底，避免误提交）
# ------------------------------------------------------------------------------
*.tmp
*.temp
*_local.*
~$*


# ==============================================================================
#  以下内容虽然「看起来像产物」，但**必须提交**，故不做忽略。
#  列出以免将来有人顺手加规则把它们一起忽略掉：
#
#    MssqlFieldFinder.spec    构建参数的唯一来源（单文件/排除项/入口都在这里）。
#                             注意它和产物目录 /MssqlFieldFinder/ 同名不同物——
#                             上面的规则匹配的是「目录」，不会影响这个 .spec 文件。
#    bat/build.bat            一键打包脚本（找环境 → 读名称版本 → 打包 → 报 SHA256）
#    bat/run.bat             源码启动脚本
#    bat/诊断环境.bat         环境诊断脚本
#    tools/                   开发辅助脚本（进程内/外部窗口截图），非运行时依赖但有复用价值
#    docs/*.md               设计、计划、审查、交付报告与打包说明
#    docs/images/*.png       真实窗口截图，作为界面证据随文档一起提交
#    main.py / src/ / tests/  程序本体与测试
#    *.md                     设计、计划、审查、交付报告与打包说明
#
#  如果将来想随仓库提供一份「配置模板」，建议用下面两行放行，
#  并确保模板里不写真实服务器与密码（把值留空或写成占位符）：
#    !config.example.json
#    !connections.example.json
# ==============================================================================
